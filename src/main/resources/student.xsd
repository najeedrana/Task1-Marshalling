<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="student"><xs:complexType><xs:sequence>
    <xs:element name="id" type="xs:int"/>
    <xs:element name="name" type="xs:string"/>
    <xs:element name="age" type="xs:int"/>
    <xs:element name="averageGrade" type="xs:float"/>
    <xs:element name="active" type="xs:boolean"/>
    <xs:element name="middleInitial" type="xs:string"/>
    <xs:element name="subjects"><xs:complexType><xs:sequence>
      <xs:element name="subject" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType><xs:sequence>
          <xs:element name="id" type="xs:int"/>
          <xs:element name="name" type="xs:string"/>
          <xs:element name="grade" type="xs:float"/>
          <xs:element name="passed" type="xs:boolean"/>
        </xs:sequence></xs:complexType>
      </xs:element>
    </xs:sequence></xs:complexType></xs:element>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>
